# Frontend API path. Keep /api/v1 to use the Vite (development) and Vercel (production) proxies.
VITE_API_BASE_URL=/api/v1

# Local backend origin for the Vite proxy. Production uses the server-only BACKEND_API_URL in Vercel.
API_PROXY_TARGET=http://localhost:8001

# In Vercel project settings, set BACKEND_API_URL to the backend API base URL including /api/v1.
